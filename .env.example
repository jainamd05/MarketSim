# ---------------------------------------------------------------
# MarketSim AI configuration. Copy to backend/.env and fill in.
# With NO keys at all the app runs in clearly-labelled DEMO mode.
# ---------------------------------------------------------------

# SerpApi key (https://serpapi.com/manage-api-key). Required for LIVE mode.
SERPAPI_API_KEY=

# DEMO_MODE: auto | true | false
#   auto  -> LIVE when SERPAPI_API_KEY is set, otherwise DEMO
#   true  -> always use saved fixtures (no network)
#   false -> always LIVE (analyses fail honestly if no key)
DEMO_MODE=auto

# Request budget per analysis and persistent cache TTL
MAX_SERPAPI_REQUESTS_PER_ANALYSIS=12
SERPAPI_CACHE_TTL_SECONDS=86400
SERPAPI_TIMEOUT_SECONDS=25
SERPAPI_MAX_CONCURRENCY=3

# LLM_PROVIDER: none | openai | anthropic | groq | gemini
#   none -> deterministic, rule-based strategy generation (clearly labelled)
LLM_PROVIDER=none
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Free-tier friendly providers (OpenAI-compatible endpoints)
GROQ_API_KEY=
GEMINI_API_KEY=

# SQLite database (relative paths are resolved from the backend/ directory)
DATABASE_URL=sqlite:///./marketsim.db

# Comma-separated list of allowed browser origins for the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
